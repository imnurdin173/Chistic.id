generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANIZER
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  role          Role      @default(CUSTOMER)
  referralCode  String?
  points        Int?
  sessions      Session[]
  accounts      Account[]
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}


enum EventCategoryEnum {
  MUSIC
  SEMINAR
  TALKSHOW
  SPORTS
  EXHIBITION
}

enum EventStatusEnum {
  DRAFT
  UPCOMING
  ON_STAGE
  ENDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRM
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

model Event {
  id          String            @id @default(uuid())
  organizerId String
  organizer   User              @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  title       String
  category    EventCategoryEnum @default(MUSIC)

  startDate DateTime  @default(now())
  endDate DateTime  @default(now())

  description String            @db.Text
  province    String
  city        String
  venueMaps   String?
  venueDetail String
  totalTicket Int               @default(0)

  thumbnailImage String?
  coverImages    String[] @default([])
  videoUrl       String?

  status                EventStatusEnum @default(DRAFT)
  scheduledPublishStart DateTime?
  scheduledPublishEnd   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  ticketTiers  TicketTier[]
  vouchers     Voucher[]
  transactions Transaction[]
  reviews      Review[]

  @@map("events")
}

model TicketTier {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name       String
  price      Decimal @db.Decimal(12, 2)
  finalPrice Decimal @db.Decimal(12, 2)
  quota      Int
  sold       Int     @default(0)

  isPresale    Boolean   @default(false)
  preSaleStart DateTime?
  preSaleEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@map("ticket_tiers")
}

model Voucher {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  code         String       @unique
  discountType DiscountType @default(PERCENTAGE)
  discount     Decimal      @db.Decimal(12, 2)
  validStart   DateTime
  validEnd     DateTime
  usedCount    Int          @default(0)
  maxUsage     Int          @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime

  transactions Transaction[]

  @@map("vouchers")
}

model Transaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  ticketTierId String
  tickerTier   TicketTier @relation(fields: [ticketTierId], references: [id])

  voucherId String?
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  status     TransactionStatus @default(WAITING_PAYMENT)
  quantity   Int               @default(1)
  totalPrice Decimal           @db.Decimal(12, 2)
  pointUsed  Int               @default(0)

  paymentProof         String?
  paymentDeadline      DateTime
  adminConfirmDeadline DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eTickets ETicket[]

  @@map("transactions")
}

model ETicket {
  id            String      @id @default(uuid())
  transactionId String
  transcation   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  ticketCode String    @unique
  qrPayLoad  String    @db.Text
  isAttended Boolean   @default(false)
  attendedAt DateTime?
  pdfUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@map("e_tickets")
}

model Review {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eTicketId String
  eTicket   ETicket @relation(fields: [eTicketId], references: [id])

  rating    Int
  comment   String    @db.Text
  reply     String?   @db.Text
  repliedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("reviews")
}